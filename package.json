  "scripts": {
    "audit:apk": "node ./script/auditapk.js",
    "build": "tsc -P tsconfig.build.json && tsc-esm-fix --tsconfig=tsconfig.build.json --ext=.js",
    "build:all": "npm run build && npm run build:docs",
    "build:docs": "typedoc",
    "build:docs2": "node ./script/apiref.js site-api.json && node ./script/builddocs.js site",
    "changelog:last": "conventional-changelog -p angular -r 2",
    "changelog:preview": "conventional-changelog -p angular -u",
    "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "check:engine": "node engine-requirements-anya.js",
    "check:proto": "node ./script/checkproto.js",
    "check:tracked": "node scripts/check-tracked.mjs",
    "example": "tsx ./Example/example.ts",
    "fetch:bundle": "node ./script/fetchbundle.js",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "formatt": "prettier --write *",
    "formattt": "prettier --write .",
    "gen:protobuf": "sh WAProto/GenerateStatics.sh",
    "lint": "tsc && eslint src --ext .js,.ts",
    "lint:fix": "npm run format && tsc && eslint src --ext .js,.ts --fix",
    "lint:fixAlt": "npm run format && npm run lint -- --fix",
    "preinstall": "node ./engine-requirements-anya.js",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "proto:update": "npm run sync:proto && npm run build && npm run verify:proto && npm run verify:mex && npm run wa:update -- --apply --keep 2 && node ./script/updatewa.js",
    "proto:update2": "npm run sync:proto && npm run verify:proto && npm run verify:mex && npm run wa:update -- --apply --keep 2 && npm run update:version2",
    "readme": "node scripts/build-readme.mjs",
    "readme:apply": "node scripts/generate-readme.mjs --apply",
    "readme:check": "node scripts/build-readme.mjs --quiet",
    "readme:generate": "node scripts/generate-readme.mjs",
    "readme:index": "node scripts/generate-readme.mjs --index",
    "release": "release-it",
    "sync:proto": "node ./script/syncproto.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testMatch '**/*.test.ts'",
    "test2": "node --test \"test/*.test.js\"",
    "test:all": "npm run build && npm test && npm run test:compat",
    "test:compat": "node --test test/builder.test.js test/groups.test.js test/html.test.js test/messages.test.js test/runtime.test.js test/status.test.js test/username.test.js test/voip.test.js",
    "test:e2e": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --experimental-vm-modules ./node_modules/.bin/jest --runInBand --forceExit --testMatch '**/*.test-e2e.ts'",
    "test:e2e2": "node --test \"test/e2e/*.test.js\"",
    "test:pairing": "node ./script/testpairing.js",
    "update:version": "tsx ./scripts/update-version.ts",
    "update:version2": "node ./script/updatewa.js",
    "verify:assets": "node ./scripts/verify-voip-assets.mjs",
    "verify:assets2": "node ./script/verifyassets.js",
    "verify:mex": "node ./script/verifymex.js",
    "verify:proto": "node ./script/verifyproto.js",
    "wa:diff": "node ./script/diffbundle.js",
    "wa:update": "node ./script/waupdate.js"
  },
  "resolutions": {
    "ajv@npm:^6.12.4": "^6.14.0",
    "basic-ftp": "^5.2.4",
    "brace-expansion@npm:^1.1.7": "^1.1.13",
